# Shared
PORT=4000
USE_SUPABASE=true
BOOTSTRAP_SUPABASE=true

# Supabase / Auth / REST
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Governed workers
CRON_SECRET=your-random-worker-secret

# Knowledge Learning Agent / Vercel AI Gateway
# Configure AI_GATEWAY_API_KEY server-side, or enable Vercel OIDC for AI Gateway.
AI_GATEWAY_API_KEY=your-vercel-ai-gateway-key
KNOWLEDGE_LEARNING_MODEL=openai/gpt-5.4

# Mais Retorno API
# Store the real credential only in Vercel/Supabase environment variables.
MAIS_RETORNO_API_KEY=your-mais-retorno-key
MAIS_RETORNO_API_BASE_URL=https://developers.maisretorno.com
MAIS_RETORNO_API_PATH=mcp
MAIS_RETORNO_MONTHLY_QUOTA=500
MAIS_RETORNO_MONTHLY_TARGET=500

# Agentetome API / MCP
# Store the real credential only as a server-side secret. Never prefix it with VITE_.
AGENTETOME_API_KEY=your-agentetome-key
AGENTETOME_API_BASE_URL=https://www.agentetome.com
AGENTETOME_MCP_URL=https://www.agentetome.com/api/mcp

# Frontend runtime
# Local development:
VITE_API_BASE_URL=http://localhost:4000
# Production canonical URL while motor-originac-srm.vercel.app alias is unavailable:
# VITE_API_BASE_URL=https://motor-originac-srm-marcelo-teets-projects.vercel.app/api
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# CAPTCHA do Supabase Auth. O provider e a site key precisam corresponder
# exatamente ao CAPTCHA habilitado em Authentication > Bot and Abuse Protection.
VITE_CAPTCHA_ENABLED=true
VITE_CAPTCHA_PROVIDER=turnstile
VITE_CAPTCHA_SITE_KEY=your-public-captcha-site-key

# OAuth Google é configurado no Supabase Auth; o frontend usa /auth/callback.
# Adicione os domínios de produção e preview à Redirect URLs allow list do Supabase.
