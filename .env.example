# Shared
PORT=4000
USE_SUPABASE=true
BOOTSTRAP_SUPABASE=true

# Supabase / Auth / REST
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Governed workers
CRON_SECRET=your-random-worker-secret

# Historical archive
# Supabase is the hot database. Google Drive/Sheets is the historical database.
# Keep supabase_storage only during credential setup and smoke testing.
ARCHIVE_STORAGE_PROVIDER=google_drive
GOOGLE_DRIVE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_DRIVE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_DRIVE_REFRESH_TOKEN=your-google-oauth-refresh-token
GOOGLE_DRIVE_ARCHIVE_FOLDER_ID=16RwLyzLUm45BshgO5Qkr9kZunYBfDuNV
GOOGLE_DRIVE_CATALOG_SPREADSHEET_ID=1z29lCdGlZdndvurzZP7LqGPOreyIm5onlnmFvUquY3Y
SUPABASE_DB_TARGET_MB=400
SUPABASE_DB_WARNING_MB=425
SUPABASE_DB_CRITICAL_MB=450
SUPABASE_DB_EMERGENCY_MB=475

# Knowledge Learning Agent / Vercel AI Gateway
# Configure AI_GATEWAY_API_KEY server-side, or enable Vercel OIDC for AI Gateway.
AI_GATEWAY_API_KEY=your-vercel-ai-gateway-key
KNOWLEDGE_LEARNING_MODEL=openai/gpt-5.4

# Mais Retorno API
# Store the real credential only in Vercel/Supabase environment variables.
MAIS_RETORNO_API_KEY=your-mais-retorno-key
MAIS_RETORNO_API_BASE_URL=https://developers.maisretorno.com
MAIS_RETORNO_API_PATH=mcp
MAIS_RETORNO_MONTHLY_QUOTA=500
MAIS_RETORNO_MONTHLY_TARGET=500

# Agentetome API / MCP
# Store the real credential only as a server-side secret. Never prefix it with VITE_.
AGENTETOME_API_KEY=your-agentetome-key
AGENTETOME_API_BASE_URL=https://www.agentetome.com
AGENTETOME_MCP_URL=https://www.agentetome.com/api/mcp

# Frontend runtime
VITE_API_BASE_URL=http://localhost:4000
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# OAuth Google is configured in Supabase Auth; the frontend uses /auth/callback.
