# Backend / Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
USE_SUPABASE=true
BOOTSTRAP_SUPABASE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://motor-originac-srm-marcelo-teets-projects.vercel.app,https://motor-originac-srm.vercel.app

# Server
PORT=4000
CRON_SECRET=

# Mais Retorno / external data providers
MAIS_RETORNO_API_KEY=
MAIS_RETORNO_API_BASE_URL=https://api.maisretorno.com/v1
MAIS_RETORNO_API_PATH=/fundos/fiis
MAIS_RETORNO_MONTHLY_QUOTA=500
MAIS_RETORNO_MONTHLY_TARGET=500

# Frontend build-time variables
VITE_API_BASE_URL=http://localhost:4000
VITE_DEMO_EMAIL=admin@example.com
VITE_DEMO_PASSWORD=change-me

