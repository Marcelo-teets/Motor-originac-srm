# Shared
PORT=4000
USE_SUPABASE=true
BOOTSTRAP_SUPABASE=true

# Supabase / Auth / REST
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_REF=your-project-ref

# Governed workers
CRON_SECRET=your-random-worker-secret

# Supabase hot / Google Drive + Sheets cold archive
GOOGLE_DRIVE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_DRIVE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_DRIVE_REFRESH_TOKEN=your-google-oauth-refresh-token
GOOGLE_DRIVE_ARCHIVE_FOLDER_ID=16RwLyzLUm45BshgO5Qkr9kZunYBfDuNV
GOOGLE_DRIVE_CATALOG_SPREADSHEET_ID=1z29lCdGlZdndvurzZP7LqGPOreyIm5onlnmFvUquY3Y
SUPABASE_DB_TARGET_MB=400
SUPABASE_DB_WARNING_MB=425
SUPABASE_DB_CRITICAL_MB=450
SUPABASE_DB_EMERGENCY_MB=475

# Zero-cost AI runtime — policy locked until explicit revocation
# Paid AI providers are intentionally not configured or used by application runtime.
# OpenAI, Anthropic and paid AI Gateway credentials must remain unused even if legacy
# secrets still exist in Vercel/GitHub. Revocation of this policy requires an explicit
# repository change and user authorization.
ZERO_COST_AI_POLICY=locked
FREE_INFERENCE_BASE_URL=https://hungry-mountainous-harddrives--antunespmarcelo.replit.app
FREE_INFERENCE_MODEL=motor-local

# Mais Retorno Data API v4 — server-side only
# Current operational canary only uses the zero-credit /search endpoint.
MAIS_RETORNO_API_KEY=your-mais-retorno-key
MAIS_RETORNO_API_BASE_URL=https://data.maisretorno.com/mr-data/v4/api
MAIS_RETORNO_MONTHLY_QUOTA=500
MAIS_RETORNO_MONTHLY_TARGET=500

# Agentetome API / MCP
# Store the real credential only as a server-side secret. Never prefix it with VITE_.
AGENTETOME_API_KEY=your-agentetome-key
AGENTETOME_API_BASE_URL=https://www.agentetome.com
AGENTETOME_MCP_URL=https://www.agentetome.com/api/mcp

# Microsoft Planner + To Do — server-side only
MICROSOFT_CLIENT_ID=your-microsoft-application-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=https://motor-originac-srm.vercel.app/api/integrations/microsoft/callback
MICROSOFT_PLANNER_GROUP_ID=your-microsoft-365-group-id
MICROSOFT_TOKEN_ENCRYPTION_KEY=your-random-strong-encryption-key
MICROSOFT_STATE_SECRET=your-random-strong-state-secret
MICROSOFT_SCOPES=openid profile email offline_access User.Read Tasks.ReadWrite Group.Read.All
APP_BASE_URL=https://motor-originac-srm.vercel.app

# Vercel deployment / public-auth synchronization — CI or operator environment only
VERCEL_TOKEN=your-vercel-token
VERCEL_ORG_ID=your-vercel-team-id
VERCEL_PROJECT_ID=your-vercel-project-id

# Frontend runtime — public values only
VITE_API_BASE_URL=http://localhost:4000
# VITE_API_URL is a legacy local-development alias. Prefer VITE_API_BASE_URL.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-sb-publishable-key
# Legacy anon JWT remains supported for backwards compatibility.
VITE_SUPABASE_ANON_KEY=your-anon-key

# OAuth Google para login é configurado no Supabase Auth; o frontend usa /auth/callback.
