{
  "name": "motor-originac-srm",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm -C backend run dev",
    "dev:frontend": "npm -C frontend run dev",
    "dev:backend": "npm -C backend run dev",
    "build": "npm -C backend run build && npm -C frontend run build",
    "build:frontend": "npm -C frontend run build",
    "build:backend": "npm -C backend run build",
    "lint": "npm -C backend run lint && npm -C frontend run lint",
    "test:auth-captcha-payload": "npx tsx --test scripts/captcha-auth-payload.test.ts",
    "test:auth-config-audit": "node scripts/audit-supabase-auth-config.test.mjs",
    "test:auth-production-smoke": "node scripts/smoke-auth-production.test.mjs",
    "test:company-credit-review": "npx tsx --test backend/src/lib/companyCreditReview.test.ts backend/src/lib/approvedCreditReviewQualification.test.ts",
    "test:vercel-deploy-guard": "node scripts/vercel-deployment-config.test.mjs && bash scripts/vercel-ignore-build.test.sh",
    "test:vercel-production-control": "node scripts/vercel-production-control.test.mjs",
    "ops:materialize-company-decision": "npx tsx scripts/materialize-company-decision.ts",
    "vercel:production-control": "node scripts/vercel-production-control.mjs",
    "typecheck:serverless": "tsc -p tsconfig.serverless.json",
    "typecheck": "npm -C backend run typecheck && npm -C frontend run typecheck && npm run typecheck:serverless"
  }
}
