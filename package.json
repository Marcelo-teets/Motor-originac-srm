{
  "name": "motor-originac-srm",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm -C backend run dev",
    "dev:frontend": "npm -C frontend run dev",
    "dev:backend": "npm -C backend run dev",
    "build": "npm -C backend run build && npm -C frontend run build",
    "build:frontend": "npm -C frontend run build",
    "build:backend": "npm -C backend run build",
    "lint": "npm -C backend run lint && npm -C frontend run lint",
    "test:frontend-quality": "node --test scripts/frontend-quality-contract.test.mjs",
    "test:search-discovery-quality": "tsx --test backend/src/lib/searchDiscoveryQuality.test.ts backend/src/lib/candidateRediscoveryLineage.test.ts backend/src/services/searchProfileScheduledRunner.test.ts",
    "test:auth-captcha-retirement": "node --test scripts/retire-captcha-production.test.mjs",
    "test:auth-config-audit": "node scripts/audit-supabase-auth-config.test.mjs",
    "test:auth-public-env": "node --test scripts/sync-public-auth-env-to-vercel.test.mjs",
    "test:auth-production-smoke": "node --test scripts/smoke-auth-production.test.mjs",
    "test:company-credit-review": "tsx --test backend/src/lib/companyCreditReview.test.ts backend/src/lib/approvedCreditReviewQualification.test.ts",
    "test:agentetome-production": "node --test scripts/agentetome-production-contract.test.mjs",
    "test:fidcs-source": "tsx --test backend/src/lib/fidcsComBr.test.ts",
    "test:knowledge-learning-service-role": "node --test scripts/knowledge-learning-service-role-contract.test.mjs",
    "test:knowledge-learning-oidc": "node --test scripts/knowledge-learning-oidc-contract.test.mjs",
    "test:knowledge-learning-queue": "node --test scripts/knowledge-learning-queue-governance.test.mjs",
    "test:pipeline-eligibility": "node --test scripts/pipeline-eligibility-contract.test.mjs",
    "test:database-hardening": "node --test scripts/database-ownership-lineage-contract.test.mjs",
    "test:capture-derived-decision-gate": "node --test scripts/capture-derived-decision-contract.test.mjs",
    "test:archive-queue-runtime": "node --test scripts/archive-queue-runtime-contract.test.mjs",
    "test:supabase-edge-source": "node --test scripts/supabase-edge-source-contract.test.mjs",
    "test:vercel-deploy-guard": "node scripts/vercel-deployment-config.test.mjs && bash scripts/vercel-ignore-build.test.sh",
    "test:vercel-function-budget": "node scripts/vercel-function-budget.test.mjs",
    "test:vercel-production-control": "node scripts/vercel-production-control.test.mjs",
    "test:vercel-production-workflow": "node scripts/vercel-production-workflow.test.mjs",
    "test:vercel-runtime-stability": "node --test scripts/vercel-runtime-stability-contract.test.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "ops:materialize-company-decision": "tsx scripts/materialize-company-decision.ts",
    "vercel:production-control": "node scripts/vercel-production-control.mjs",
    "typecheck:serverless": "tsc -p tsconfig.serverless.json",
    "typecheck": "npm -C backend run typecheck && npm -C frontend run typecheck && npm run typecheck:serverless"
  },
  "devDependencies": {
    "tsx": "4.19.3"
  }
}
